# Copiar este archivo como .env y completar solamente en el equipo local.
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8082/'

# Conexión PostgreSQL. No publicar la contraseña real.
database.default.hostname = localhost
database.default.database = biblioteca_libros
database.default.username = postgres
database.default.password = CAMBIAR_CONTRASENA
database.default.DBDriver = Postgre
database.default.port = 5432

# Los cuatro servicios deben utilizar exactamente la misma clave JWT.
AUTH_JWT_SECRET = CAMBIAR_POR_UNA_CLAVE_PRIVADA_LARGA
AUTH_JWT_EXPIRATION = 3600
